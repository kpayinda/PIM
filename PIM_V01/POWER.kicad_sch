	(text_box "CONTROL SIGNALS\n\nVSEL: DAC driven R in FB loop, MCU trim output. Bump to compensate harnessing losses etc. \n\nSYNC: feed PWM in to force reg to sw at ecact freq (no noise drifting to radio freqs)."
		(exclude_from_sim no)
		(at 146.05 -55.88 0)
		(size 86.36 39.37)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
